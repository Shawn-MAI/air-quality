# Copy this file to .env and replace each secret placeholder before running make up.
# Git ignores .env. Never commit real values.

# Host port for the data store.
POSTGRES_PORT=5432

# Database name.
POSTGRES_DB=airquality

# Bootstrap superuser, used only by container initialisation.
POSTGRES_ADMIN_USER=airquality_admin

# Bootstrap superuser password (placeholder; replace locally). Secret.
POSTGRES_ADMIN_PASSWORD=change-me-admin

# Non-superuser role used by the application and tests.
APP_DB_USER=airquality_app

# Application role password (placeholder; replace locally). Secret.
APP_DB_PASSWORD=change-me-app
